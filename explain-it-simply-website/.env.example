# Explain It Simply — web server configuration
# Copy to .env (never commit .env). Every value here is SERVER-ONLY: the browser
# never receives a provider key, and /api/catalog deliberately omits them.

# --- provider -----------------------------------------------------------
# Provider to use: google, anthropic, openai, groq, openrouter, kimi.
EIS_PROVIDER=google

# Model id for that provider (built-in list: shared/providers/registry.js).
# Any well-formed id is accepted: an aggregator route that is not in the built-in
# list is sent as typed and the server prints a notice at startup rather than
# refusing to boot. With EIS_PROVIDER=openrouter, free routes end in `:free`,
# e.g. EIS_MODEL=google/gemma-4-31b-it:free (the list rotates; check
# https://openrouter.ai/models). OpenRouter needs attribution headers, which the
# app sends by itself.
EIS_MODEL=gemini-3.8-flash

# The key the selected provider reads. Named after the provider on purpose so a
# stray key cannot be used against the wrong vendor.
GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# MOONSHOT_API_KEY=

# Extra keys for the SAME provider, comma-separated (note the trailing S). When a
# provider rejects or rate-limits one, the request is retried on the next key and
# the failed key cools down for 60s (5 min if the provider called it invalid).
# A bad model id or an unreadable answer never rotates keys.
GOOGLE_API_KEYS=
# EIS_API_KEYS=  same list, used when set and the provider-specific one is empty

# --- answers ------------------------------------------------------------
# Default explanation depth: quick | balanced | deep
EIS_DEPTH=balanced
# Language of the prose (code stays as written): "en", "French", "Hindi", ...
EIS_LANGUAGE=en
# Ask providers with native JSON modes to enforce the answer schema.
# Set to false if a provider rejects the extra request fields.
EIS_STRUCTURED_OUTPUT=true

# --- network ------------------------------------------------------------
PORT=3000
# Loopback by default. Anything else makes this a paid-API proxy: if you change
# it, also set EIS_ACCESS_TOKEN (the server refuses to start otherwise).
EIS_HOST=127.0.0.1
# Comma-separated origins allowed to call /api cross-origin. Empty = same-origin.
EIS_ALLOWED_ORIGINS=
# Optional bearer token required on /api requests (the frontend asks for it).
EIS_ACCESS_TOKEN=

# Set to false when a reverse proxy buffers text/event-stream responses; the app
# then uses the plain POST endpoint instead of streaming.
EIS_STREAMING=true

# --- limits -------------------------------------------------------------
EIS_REQUEST_TIMEOUT_MS=45000
# Extra attempts for transient failures only (429, network, timeout). Never for
# bad keys, bad models or unreadable answers.
EIS_MAX_RETRIES=2
EIS_MAX_BODY_BYTES=32768
# Requests per window per address, plus a small burst allowance.
EIS_RATE_LIMIT=20
EIS_RATE_WINDOW_MS=60000
EIS_RATE_BURST=5
# How many proxies stand in front of this server. 0 = none, so X-Forwarded-For is
# ignored and the socket address is used. Set to 1 behind one trusted nginx/etc.
EIS_TRUST_PROXY=0
# Concurrent upstream explanations allowed before new requests get 429. 0 = no cap.
EIS_MAX_INFLIGHT=2
# Total explanation requests served per UTC day per process. 0 = unlimited.
EIS_DAILY_REQUEST_CAP=300
# Logging is structured and never includes prompt text, source code or keys.
# Levels: error | warn | info
EIS_LOG_LEVEL=info
